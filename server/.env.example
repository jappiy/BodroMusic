# Шаблон секретов bodrod для docker compose (скопируйте в .env рядом с docker-compose.yml, chmod 600).
# Пароль админа Navidrome и токены Яндекса — файлами в /secrets (см. docker-compose.example.yml).

# slskd и Lidarr
SLSKD_API_KEY=
LIDARR_API_KEY=

# Привязка аккаунтов Яндекса: логин_navidrome:логин_яндекса через запятую.
# Логин Яндекса — имя файла токена в /secrets/yandex_accounts/. Пример: nikolai:jappi,olga:kalainidi
YANDEX_USERS=

# ListenBrainz — источник рекомендаций.
# Токен: listenbrainz.org → Settings → User token (или файлом /secrets/listenbrainz_token).
LISTENBRAINZ_TOKEN=
# Пользователи: логин_navidrome:логин_lb через запятую (плейлисты Weekly Exploration / Weekly Jams).
# Пример: nikolai:jappi,olga:kalainidi
LISTENBRAINZ_USERS=
